package com.example.tethr

import android.accessibilityservice.AccessibilityService
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.content.IntentFilter
import android.content.SharedPreferences
import android.os.Handler
import android.os.Looper
import android.util.Log
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo
import com.example.tethr.data.SessionRepository

/**
 * TethrAccessibilityService â€” core engine of the Escalation Matrix.
 *
 * Root causes fixed in this revision
 * â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 * BUG A â€” False exit from keyboard/SystemUI
 *   When we removed the packageNames XML filter (needed to detect home-screen
 *   exit), we started receiving TYPE_WINDOW_STATE_CHANGED from EVERY system
 *   overlay: keyboards, status-bar pull-downs, toasts, permission dialogsâ€¦
 *   These packages are NOT in TARGET_PACKAGES â†’ debounce fires â†’ hideAll().
 *   The ~5-second delay before the first disappearance matches when Instagram's
 *   keyboard first appears (search bar auto-focus etc.).
 *   FIX: isTransientSystemPackage() silently drops events from known system
 *   overlays, keyboards, and IMEs. Only "real" foreground app changes go through.
 *
 * BUG B â€” Restored tier immediately overwritten
 *   onTargetAppOpened() called restoreTierState() (which correctly set
 *   currentTier=2/3 and showed the right overlay), then unconditionally
 *   overwrote it with showTier1() + currentTier=1. Result: math quiz shown
 *   for ~1 frame, then hideTask() from showTier1() removed it.
 *   FIX: restructured so showTier1/currentTier=1 only run for fresh sessions;
 *   resume sessions call showTier1 as a base then restoreTierState upgrades it.
 *
 * BUG C â€” Multiple stacked timers on rapid re-entry
 *   If onTargetAppOpened() was called twice (e.g. Instagram fires multiple
 *   activity transitions on launch), two timeTrackerRunnable loops would run
 *   concurrently, doubling every tick's side effects.
 *   FIX: guard at the top of onTargetAppOpened() â€” bail if the session is
 *   already running (currentTier > 0 and same package).
 */
class TethrAccessibilityService : AccessibilityService() {

    // â”€â”€ Core State â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private var cumulativeActiveMs: Long = 0L
    private var currentTier = 0             // 0=idle, 1, 2, 3
    private var tier3ExtensionMs: Long = 0L
    private var triggerTime: Long = 0L
    private var toxicWordTriggered = false
    private var sessionStartTime: Long = 0L

    private val installedKeyboards: Set<String> by lazy {
        val imm = getSystemService(Context.INPUT_METHOD_SERVICE) as android.view.inputmethod.InputMethodManager
        imm.inputMethodList.map { it.packageName }.toSet()
    }

    // â”€â”€ Package tracking â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Single source of truth â€” updated only when a non-transient package change
    // is confirmed after the 1000ms debounce.
    private var currentForegroundPackage: String = ""

    // â”€â”€ Dependencies â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private lateinit var overlayManager: OverlayManager
    private lateinit var sessionRepo: SessionRepository
    private lateinit var prefs: SharedPreferences
    private val mainHandler = Handler(Looper.getMainLooper())



    // â”€â”€ 1-second tick â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private val timeTrackerRunnable = object : Runnable {
        override fun run() {
            // Leak guard â€” if a target app isn't foreground, stop and clean up
            if (currentForegroundPackage !in TARGET_PACKAGES) {
                Log.d(TAG, "Tick leak: $currentForegroundPackage not in whitelist â†’ hideAll()")
                overlayManager.hideAll()
                return  // do NOT re-post
            }
            cumulativeActiveMs += TICK_MS
            evaluateTier()
            overlayManager.updateTime(cumulativeActiveMs)
            sessionRepo.saveActiveState(cumulativeMs = cumulativeActiveMs, lastExitTimestamp = 0L)
            mainHandler.postDelayed(this, TICK_MS)
        }
    }

    // â”€â”€ Screen-off receiver â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private val screenOffReceiver = object : BroadcastReceiver() {
        override fun onReceive(context: Context, intent: Intent) {
            if (intent.action == Intent.ACTION_SCREEN_OFF) {
                Log.d(TAG, "Screen OFF â†’ hideAll()")
                overlayManager.hideAll()
            }
        }
    }

    // â”€â”€ NLP toxic word list â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private val toxicWords = setOf(
        "hate", "ugly", "rage", "stupid", "worst", "disgusting",
        "horrible", "trash", "loser", "dumb", "idiot", "kill",
        "die", "awful", "repulsive", "pathetic", "worthless",
        "scum", "filth", "nasty", "vile", "gross"
    )
    private var lastNlpScanTime = 0L

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Service Lifecycle
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    override fun onServiceConnected() {
        super.onServiceConnected()
        Log.d(TAG, "TethrAccessibilityService connected")
        prefs = getSharedPreferences("tethr_prefs", Context.MODE_PRIVATE)
        sessionRepo = SessionRepository(this)
        overlayManager = OverlayManager(this)
        registerReceiver(screenOffReceiver, IntentFilter(Intent.ACTION_SCREEN_OFF))
        startForegroundService(Intent(this, TethrForegroundService::class.java))
    }

    override fun onDestroy() {
        super.onDestroy()
        Log.d(TAG, "Service destroyed")
        cleanupOnExit()
        try { unregisterReceiver(screenOffReceiver) } catch (_: Exception) {}
    }

    override fun onInterrupt() {
        Log.d(TAG, "Service interrupted")
        cleanupOnExit()
    }

    // ————————————————————————————————————————————————————————————————————————————
    // Accessibility Events
    // ————————————————————————————————————————————————————————————————————————————

    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        if (event == null) return
        val pkg = event.packageName?.toString() ?: ""

        when (event.eventType) {

            AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED -> {
                val eventPkg = event.packageName?.toString() ?: ""
                if (eventPkg.isEmpty()) return

                // 1. DIRECT HIT: Trust target apps immediately.
                if (eventPkg in TARGET_PACKAGES) {
                    if (currentForegroundPackage != eventPkg) {
                        currentForegroundPackage = eventPkg
                        Log.d(TAG, "Foreground -> $eventPkg")
                        onTargetAppOpened(eventPkg)
                    }
                    return
                }

                // 2. LAUNCHER EXIT: Exiting to home screen explicitly
                val isLauncher = eventPkg.contains("launcher", ignoreCase = true)
                        || eventPkg.contains("home", ignoreCase = true)

                if (isLauncher) {
                    if (currentForegroundPackage.isNotEmpty()) {
                        currentForegroundPackage = ""
                        Log.d(TAG, "Foreground -> $eventPkg (Confirmed exit via home)")
                        onTargetAppLeft()
                    }
                    return
                }

                // 3. SYSTEM UI (The tricky part): Distinguish Notification Shade vs Gesture Swipe
                if (eventPkg == "com.android.systemui" || eventPkg.contains("sysui", ignoreCase = true)) {
                    val className = event.className?.toString() ?: ""
                    var isNotificationOrVolume = className.contains("Notification", ignoreCase = true)
                            || className.contains("StatusBar", ignoreCase = true)
                            || className.contains("Volume", ignoreCase = true)
                            || className.contains("panel", ignoreCase = true)

                    // Physics-based fallback: Notification shades drop from the very top of the screen (y=0).
                    // Gesture navigation bars live at the very bottom.
                    try {
                        val node = event.source
                        if (node != null) {
                            val rect = android.graphics.Rect()
                            node.getBoundsInScreen(rect)
                            if (rect.top <= 100) {
                                isNotificationOrVolume = true
                            }
                        }
                    } catch (e: Exception) {}

                    if (isNotificationOrVolume) {
                        // User pulled down the notification shade or volume slider while in Instagram. 
                        // Keep the pill alive!
                        return
                    } else {
                        // User swiped up from the bottom (Gesture Navigation). Kill the pill instantly!
                        if (currentForegroundPackage.isNotEmpty()) {
                            currentForegroundPackage = ""
                            Log.d(TAG, "Foreground -> $eventPkg (Confirmed exit via gesture)")
                            onTargetAppLeft()
                        }
                        return
                    }
                }

                // 4. POPUPS & COMMENTS: Keyboards and dialogs
                val rootPkg = try { rootInActiveWindow?.packageName?.toString() } catch (e: Exception) { null }
                val isKeyboard = eventPkg.contains("inputmethod", ignoreCase = true)
                        || eventPkg.contains(".ime.", ignoreCase = true)
                        || eventPkg.contains("keyboard", ignoreCase = true)

                if (rootPkg in TARGET_PACKAGES || isKeyboard) {
                    return
                }

                // 5. LEGITIMATE EXIT: We left the app for something else (e.g. Chrome).
                if (currentForegroundPackage.isNotEmpty()) {
                    currentForegroundPackage = ""
                    Log.d(TAG, "Foreground -> $eventPkg (Confirmed exit)")
                    onTargetAppLeft()
                }
            }

            AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED -> {
                // NLP Toxic Content Scanning (Only when active)

                if (pkg in TARGET_PACKAGES
                    && currentForegroundPackage in TARGET_PACKAGES
                    && currentTier in 1..2) {
                    val now = System.currentTimeMillis()
                    if (now - lastNlpScanTime >= NLP_SCAN_INTERVAL_MS) {
                        lastNlpScanTime = now
                        scanForToxicContent()
                    }
                }
            }
        }
    }

    /**
     * Bug A fix â€” returns true for packages that are transient overlays drawn
     * ABOVE the current foreground app (keyboards, system UI, permission dialogs,
     * accessibility overlay windows, etc.) that are NOT real foreground app changes.
     *
     * Filtering rules (ordered cheapest-first):
     *  1. "android"          â€” core Android framework dialogs
     *  2. "com.android.systemui" â€” status bar, quick-settings, notifications
     *  3. Contains "inputmethod", ".ime.", "keyboard", "honeyboard", "bixby"
     *     â€” any soft keyboard. There are 50+ keyboard packages; substring match
     *     is the only sane cross-device approach.
     *  4. Tethr itself       â€” our own overlay windows fire events; ignore them.
     *
     * Launchers (home screen) are intentionally NOT filtered â€” we DO want to
     * detect when the user navigates home so we can call onTargetAppLeft().
     */
    private fun onTargetAppOpened(packageName: String) {
        // Bug C fix â€” if we're already tracking this package at a valid tier,
        // another activity transition within Instagram fired. Skip re-init.
        if (currentTier > 0) {
            Log.d(TAG, "Re-entry ignored â€” already active at Tier $currentTier")
            return
        }

        Log.d(TAG, "Target app opened: $packageName")
        toxicWordTriggered = false
        triggerTime = sessionRepo.computeTriggerTime()
        Log.d(TAG, "TriggerTime: ${triggerTime / 1000}s")

        val (savedCumulative, lastExitTimestamp) = sessionRepo.loadActiveState()
        val now = System.currentTimeMillis()

        if (lastExitTimestamp > 0 && (now - lastExitTimestamp) >= SessionRepository.COOLDOWN_MS) {
            // â”€â”€ Fresh session (â‰¥10 min away) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            Log.d(TAG, "Cooldown expired â€” fresh session")
            if (savedCumulative > 0) {
                sessionRepo.recordSession(savedCumulative)
                sessionRepo.incrementWeekSessionCount()
            }
            cumulativeActiveMs = 0L
            tier3ExtensionMs = 0L
            currentTier = 1
            sessionRepo.resetActiveState()
            overlayManager.showTier1(0L)
        } else {
            // â”€â”€ Resume session (<10 min away) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            cumulativeActiveMs = savedCumulative
            Log.d(TAG, "Resuming at ${cumulativeActiveMs / 1000}s")
            
            // Base layer: Always show Tier 1 pill on resume
            currentTier = 1
            overlayManager.showTier1(cumulativeActiveMs)

            // CRITICAL: Explicitly re-evaluate and re-draw the UI state immediately
            if (cumulativeActiveMs >= triggerTime) {
                currentTier = 2
                overlayManager.showTier2()
            }
            
            if (prefs.getBoolean("PENDING_QUIZ", false)) {
                Log.d(TAG, "Trap triggered: PENDING_QUIZ is true")
                currentTier = 3
                overlayManager.showTier3 { onTaskSolved() }
            } else if (cumulativeActiveMs >= triggerTime + TIER2_DURATION_MS + tier3ExtensionMs) {
                currentTier = 3
                overlayManager.showTier3 { onTaskSolved() }
            }

            // Ensure the background timer resumes ticking.
            sessionStartTime = System.currentTimeMillis()
            mainHandler.removeCallbacks(timeTrackerRunnable)
            mainHandler.post(timeTrackerRunnable)
        }

        sessionStartTime = System.currentTimeMillis()
        mainHandler.removeCallbacks(timeTrackerRunnable)
        mainHandler.post(timeTrackerRunnable)
    }

    private fun onTargetAppLeft() {
        if (currentTier == 0) return  // already idle, nothing to do

        Log.d(TAG, "Left target apps â€” saving state and hiding overlays")
        mainHandler.removeCallbacks(timeTrackerRunnable)

        sessionRepo.saveActiveState(
            cumulativeMs = cumulativeActiveMs,
            lastExitTimestamp = System.currentTimeMillis()
        )

        currentTier = 0
        overlayManager.hideAll()
    }

    /**
     * Bug B fix â€” called AFTER showTier1() so it can safely add grayscale/task
     * on top without fighting hideGrayscale(). Sets currentTier correctly.
     */
    private fun restoreTierState() {
        when {
            cumulativeActiveMs < triggerTime -> {
                // Tier 1 already set by caller â€” nothing to do
            }
            cumulativeActiveMs < triggerTime + TIER2_DURATION_MS + tier3ExtensionMs -> {
                currentTier = 2
                overlayManager.showTier2()
            }
            else -> {
                // Step 4: Time-based Escalation Logic
                val prefs = getSharedPreferences("TethrPrefs", Context.MODE_PRIVATE)
                val quizzesEnabled = prefs.getBoolean("ENABLE_QUIZZES", true)
                
                if (quizzesEnabled && currentTier != 3) {
                    currentTier = 3
                    mainHandler.post { overlayManager.showTier3 { onTaskSolved() } }
                } else if (!quizzesEnabled && currentTier != 2) {
                    // If quizzes are disabled, cap at Tier 2
                    currentTier = 2
                    mainHandler.post { overlayManager.showTier2() }
                }
            }
        }
    }

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Tier Evaluation (every second)
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private fun evaluateTier() {
        val scaledTime = if (sessionRepo.isDemoMode()) cumulativeActiveMs * 60 else cumulativeActiveMs
        when {
            scaledTime >= triggerTime && currentTier < 2 -> {
                Log.d(TAG, "â†’ Tier 2 at ${scaledTime / 1000}s")
                currentTier = 2
                overlayManager.showTier2()
            }
            scaledTime >= triggerTime + TIER2_DURATION_MS + tier3ExtensionMs && currentTier < 3 -> {
                val prefs = getSharedPreferences("TethrPrefs", android.content.Context.MODE_PRIVATE)
                val quizzesEnabled = prefs.getBoolean("ENABLE_QUIZZES", true)
                if (quizzesEnabled) {
                    Log.d(TAG, "â†’ Tier 3 at ${scaledTime / 1000}s")
                    currentTier = 3
                    overlayManager.showTier3 { onTaskSolved() }
                }
            }
        }
    }

    private fun onTaskSolved() {
        Log.d(TAG, "Task solved â€” +5 min Tier 2 extension")
        tier3ExtensionMs += TIER3_TASK_EXTENSION_MS
        currentTier = 2
        overlayManager.showTier2()
    }

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // NLP Scanner
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private fun scanForToxicContent() {
        if (toxicWordTriggered) return
        val rootNode = rootInActiveWindow ?: return
        try {
            val sb = StringBuilder()
            collectTextFromNode(rootNode, sb)
            val text = sb.toString().lowercase()
            for (word in toxicWords) {
                if (text.contains(word)) {
                    Log.d(TAG, "NLP: '$word' detected â†’ Tier 2")
                    toxicWordTriggered = true
                    if (currentTier < 2) { currentTier = 2; overlayManager.showTier2() }
                    break
                }
            }
        } catch (e: Exception) {
            Log.w(TAG, "NLP exception: ${e.message}")
        }
    }

    private fun collectTextFromNode(node: AccessibilityNodeInfo?, sb: StringBuilder, depth: Int = 0) {
        if (node == null || depth > MAX_NLP_DEPTH) return
        node.text?.let { sb.append(it).append(' ') }
        node.contentDescription?.let { sb.append(it).append(' ') }
        for (i in 0 until node.childCount) collectTextFromNode(node.getChild(i), sb, depth + 1)
    }

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Cleanup
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private fun cleanupOnExit() {
        currentForegroundPackage = ""
        currentTier = 0
        mainHandler.removeCallbacks(timeTrackerRunnable)
        if (cumulativeActiveMs > 0) {
            sessionRepo.saveActiveState(
                cumulativeMs = cumulativeActiveMs,
                lastExitTimestamp = System.currentTimeMillis()
            )
        }
        overlayManager.hideAll()
    }

    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Constants
    // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    companion object {
        private const val TAG = "TethrService"

        val TARGET_PACKAGES = setOf(
            "com.instagram.android",
            "com.google.android.youtube",
            "com.facebook.katana"
        )
        
        val IGNORED_PACKAGES = setOf(
            "com.android.systemui",
            "com.bbk.systemui",        // Vivo / Funtouch OS Notification Shade
            "com.miui.securitycenter", // For POCO/Xiaomi screenshot UI
            "com.google.android.inputmethod.latin"
        )

        private const val TICK_MS = 1000L
        private const val TIER2_DURATION_MS = 5 * 60_000L
        private const val TIER3_TASK_EXTENSION_MS = 5 * 60_000L
        private const val NLP_SCAN_INTERVAL_MS = 2000L
        private const val MAX_NLP_DEPTH = 8
    }
}

